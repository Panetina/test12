# Heartwood's curated NeoOrigins roster.
# Keep the selection small, readable and survival-balanced.
disable_resource_bars = false
disable_night_vision = false
disable_enhanced_vision = false

[origins]
# Heartwood roster
human = true
merling = true
avian = true
arachnid = true
caveborn = true
tiny = true
inchling = true
sporeling = true
frostborn = true
dwarf = true

# Disabled: teleportation, flight, Nether affinities, boss-like kits,
# mob-ignore safety, heavy magic/combat kits, or redundant aquatic kits.
abyssal = false
air_mage = false
asura = false
automaton = false
blazeling = false
breeze = false
cave_dragon = false
cinderborn = false
darkness_mage = false
draconic = false
earth_mage = false
elytrian = false
enderian = false
enderite = false
feline = false
fire_mage = false
forest_dragon = false
golden_body = false
golem = false
gorgon = false
gravity_mage = false
hiveling = false
iron_monk = false
kraken = false
monster_tamer = false
necromancer = false
phantom = false
piglin = false
qi_cultivator = false
revenant = false
